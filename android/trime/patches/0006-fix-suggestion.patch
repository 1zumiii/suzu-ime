+++ b/app/src/main/java/com/osfans/trime/ime/core/SuzuFix.kt
@@ -0,0 +1,201 @@
+/*
+ * SPDX-FileCopyrightText: 2026 1zumiii
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+
+package com.osfans.trime.ime.core
+
+import android.os.Handler
+import android.os.Looper
+import android.view.inputmethod.InputConnection
+import com.osfans.trime.data.base.DataManager
+import timber.log.Timber
+import java.io.File
+import java.util.concurrent.Executors
+
+// 选错修正建议（试验）：选了 AI 改过的首位后，停顿时补上右侧已打的文字，给原词与同页候选打整句分，
+// 某个候选比原词高出 THRESHOLD 时在工具栏提示“A → B”，点了才替换。
+// 记录来源：Lua 在选词时把“所选词与同页候选”登记到 librime_llm.so（fix_note），这里在上屏时按上屏文字领取（nativeTake）。
+// 打分：nativeScore 经单独的连接请求守护进程，各字对数概率之和；整句分 = score(左文 → X) + score(左文 + X → 右文)。
+// 文字只在内存里；统计只写数字（fix_stats.tsv：时间、事件、分差 ×10、原词字数、右文字数），不写日志。
+object SuzuFix {
+    const val PAUSE_MS = 1500L
+    const val THRESHOLD = 5.0
+    private const val BUDGET_MS = 300
+    private const val LEFT_MAX = 30
+    private const val RIGHT_MAX = 20
+    private const val SPAN_MAX = 40       // 原词起点到光标最多这么多字，再远就不查了
+    private const val KEEP = 4            // 最多记最近这么多个可查的选词
+
+    class Pick(val start: Int, val word: String, val cands: List<String>) {
+        var scoredRight: String? = null   // 上次打分时的右文：没变就不再打分
+        var dismissed = false             // 提示过而没采纳：不再提示
+    }
+
+    class Suggestion(val pick: Pick, val best: String, val right: String, val cursor: Int, val margin: Double)
+
+    private val loaded =
+        runCatching { System.loadLibrary("rime_llm") }
+            .onFailure { Timber.w("SuzuFix: librime_llm.so not loaded") }
+            .isSuccess
+
+    @JvmStatic
+    private external fun nativeTake(word: ByteArray): Array<ByteArray>?
+
+    @JvmStatic
+    private external fun nativeScore(ctx: ByteArray, cands: Array<ByteArray>, budgetMs: Int): DoubleArray?
+
+    private val main = Handler(Looper.getMainLooper())
+    private val worker = Executors.newSingleThreadExecutor()
+    private val picks = ArrayDeque<Pick>()
+    private var pendingCommit: Pair<String, List<String>>? = null
+    private var blocked = false
+    private var cursor = -1
+    private var gen = 0                   // 任何变化（光标、打字、换输入框）都加一，打分结果回来时不一致就丢弃
+
+    /** 当前的提示；变化时在主线程回调（null 表示收起） */
+    var current: Suggestion? = null
+        private set
+    var listener: ((Suggestion?) -> Unit)? = null
+
+    var inputConnection: () -> InputConnection? = { null }
+
+    private val check = Runnable { runCheck() }
+
+    // 进入一个输入框（密码框、无痕模式等不查）或离开
+    fun reset(block: Boolean) {
+        blocked = block
+        picks.clear()
+        pendingCommit = null
+        cursor = -1
+        cancel()
+    }
+
+    // 上屏（主线程）：Lua 登记过的词与上屏文字相同才领取，等光标更新后定位
+    fun onCommit(text: String) {
+        pendingCommit = null
+        if (!loaded || blocked || text.isEmpty()) return
+        val cs = runCatching { nativeTake(text.toByteArray()) }.getOrNull() ?: return
+        pendingCommit = text to cs.map { String(it) }
+    }
+
+    // 开始打字（出现候选）：收起提示、取消计时
+    fun onTyping() = cancel()
+
+    // 光标更新（主线程）。jumped：用户点击或拖动了光标，之前记的位置都作废
+    fun onSelection(selStart: Int, selEnd: Int, composing: Boolean, jumped: Boolean) {
+        cancel()
+        if (jumped) picks.clear()
+        cursor = if (selStart == selEnd && !composing) selStart else -1
+        if (cursor < 0 || !loaded || blocked) return
+        pendingCommit?.let { (w, cs) ->
+            pendingCommit = null
+            val start = cursor - w.length
+            val ic = inputConnection()
+            val before = runCatching { ic?.getTextBeforeCursor(w.length, 0)?.toString() }.getOrNull()
+            if (start >= 0 && before == w) {
+                picks.addLast(Pick(start, w, cs))
+                while (picks.size > KEEP) picks.removeFirst()
+            }
+        }
+        picks.removeAll { it.start >= cursor || cursor - it.start > SPAN_MAX }
+        if (picks.any { !it.dismissed }) main.postDelayed(check, PAUSE_MS)
+    }
+
+    private fun cancel() {
+        gen++
+        main.removeCallbacks(check)
+        if (current != null) {
+            current?.let { it.pick.dismissed = true; stat("ignored", it) }
+            current = null
+            listener?.invoke(null)
+        }
+    }
+
+    private class Job(val pick: Pick, val left: String, val right: String)
+
+    private fun runCheck() {
+        val g = gen
+        val cur = cursor
+        if (cur < 0) return
+        val ic = inputConnection() ?: return
+        val before = runCatching { ic.getTextBeforeCursor(SPAN_MAX + LEFT_MAX, 0)?.toString() }.getOrNull() ?: return
+        val base = cur - before.length
+        val jobs = mutableListOf<Job>()
+        for (p in picks.toList().asReversed()) {
+            if (p.dismissed) continue
+            val off = p.start - base
+            if (off < 0 || off + p.word.length > before.length || before.substring(off, off + p.word.length) != p.word) {
+                picks.remove(p)   // 前面的文字改过了，位置对不上
+                continue
+            }
+            val right = before.substring(off + p.word.length).take(RIGHT_MAX)
+            if (right.isEmpty() || right == p.scoredRight) continue
+            p.scoredRight = right
+            jobs += Job(p, before.substring(maxOf(0, off - LEFT_MAX), off), right)
+            if (jobs.size >= 3) break
+        }
+        if (jobs.isEmpty()) return
+        worker.execute {
+            var best: Suggestion? = null
+            for (j in jobs) {
+                if (gen != g) return@execute
+                val s = score(j, cur) { gen == g } ?: continue
+                if (s.margin > THRESHOLD && (best == null || s.margin > best.margin)) best = s
+            }
+            val found = best ?: return@execute
+            main.post {
+                if (gen != g || cursor != cur) return@post
+                current = found
+                stat("shown", found)
+                listener?.invoke(found)
+            }
+        }
+    }
+
+    // 后台线程：原词与候选的整句分，返回最高的候选（分差可能为负）
+    private fun score(j: Job, cur: Int, alive: () -> Boolean): Suggestion? {
+        val all = listOf(j.pick.word) + j.pick.cands.filter { it != j.pick.word }
+        if (all.size < 2) return null
+        val s0 = nativeScore(j.left.toByteArray(), all.map { it.toByteArray() }.toTypedArray(), BUDGET_MS) ?: return null
+        val pad = if (j.right == "的") "了" else "的"
+        val tot = DoubleArray(all.size)
+        for (i in all.indices) {
+            if (!alive()) return null
+            val r = nativeScore((j.left + all[i]).toByteArray(), arrayOf(j.right.toByteArray(), pad.toByteArray()), BUDGET_MS)
+                ?: return null
+            tot[i] = s0[i] + r[0]
+        }
+        var bi = 1
+        for (i in 2 until all.size) if (tot[i] > tot[bi]) bi = i
+        return Suggestion(j.pick, all[bi], j.right, cur, tot[bi] - tot[0])
+    }
+
+    /** 点了提示：核对光标前的文字仍是“原词 + 右文”，再整段替换。返回是否替换了 */
+    fun accept(replace: (Int, String) -> Boolean): Boolean {
+        val s = current ?: return false
+        current = null
+        listener?.invoke(null)
+        val ic = inputConnection()
+        val want = s.pick.word + s.right
+        val now = runCatching { ic?.getTextBeforeCursor(want.length, 0)?.toString() }.getOrNull()
+        if (cursor != s.cursor || now != want) {
+            stat("stale", s)
+            return false
+        }
+        picks.remove(s.pick)
+        val ok = replace(want.length, s.best + s.right)
+        stat(if (ok) "accepted" else "stale", s)
+        return ok
+    }
+
+    /** 点了关闭 */
+    fun dismiss() = cancel()
+
+    private fun stat(event: String, s: Suggestion) {
+        val line = "${System.currentTimeMillis() / 1000}\t$event\t${Math.round(s.margin * 10)}\t${s.pick.word.length}\t${s.right.length}\n"
+        worker.execute {
+            runCatching { File(DataManager.userDataDir, "fix_stats.tsv").appendText(line) }
+        }
+    }
+}
