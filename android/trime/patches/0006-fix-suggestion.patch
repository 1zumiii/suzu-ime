new file mode 100644
index 00000000..8c8aaf92
--- /dev/null
+++ b/app/src/main/java/com/osfans/trime/ime/core/SuzuFix.kt
@@ -0,0 +1,547 @@
+/*
+ * SPDX-FileCopyrightText: 2026 1zumiii
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+
+package com.osfans.trime.ime.core
+
+import android.os.Handler
+import android.os.Looper
+import android.view.inputmethod.InputConnection
+import com.osfans.trime.data.base.DataManager
+import timber.log.Timber
+import java.io.File
+import java.util.concurrent.Executors
+
+// 选错修正（试验），两种入口：
+// 1. 光标换词：用户把光标点到一个词上（词首或词中，即光标后的词），候选栏列出它的同音候选，按整句分从高到低排，
+//    点哪个就把原词整段换成哪个。判断“是不是选错了”交给用户，模型只负责排序，所以没有门槛。
+//    最近整段选过的词用选词时记下的同页候选；其他文字（以前打的、粘贴的）由 Lua 查词库找出词和同音词。
+// 2. 自动提示：句子里每个整段选的词，停顿时补上右侧已打的文字，给原词与同页候选打整句分，
+//    某个候选比原词高出门槛时在工具栏提示“A → B”，点了才替换。选了 AI 改过的首位的词选错率高，用较低的门槛。
+// 记录来源：Lua 在选词时把“所选词与同页候选”登记到 librime_llm.so（fix_note），这里在上屏时按上屏文字领取（nativeTake）。
+// 打分：nativeScore 经单独的连接请求守护进程，各字对数概率之和；整句分 = score(左文 → X) + score(左文 + X → 右文)。
+// 文字只在内存里；统计只写数字（fix_stats.tsv：时间、事件、分差 ×10、原词字数、右文字数、类别 1 = AI 改过的首位、
+// 名次、列出候选前等打分的毫秒数），不写日志。
+// 事件：take 上屏时领到候选，pick 在输入框里定位到原词，check 打完分（不论是否过门槛），fail 打分失败，
+//       shown 显示提示，accepted 采纳，ignored 忽略，stale 点了但文字已变；
+//       offer 光标换词列出候选（分差为排第一的候选比原词），chose 换了词（分差为所选比原词，名次从 0 起），
+//       unchosen 列出后没换；lookup 词库查到了光标处的词，lookup_none 没查到，lookup_timeout Lua 没有及时回应。
+object SuzuFix {
+    const val PAUSE_MS = 1500L
+    const val THRESHOLD = 8.0
+    const val THRESHOLD_AI = 5.0          // 选了 AI 改过的首位
+    private const val BUDGET_MS = 300
+    private const val LEFT_MAX = 30
+    private const val RIGHT_MAX = 20
+    private const val SPAN_MAX = 40       // 自动提示：原词起点到光标最多这么多字，再远就不查了
+    private const val KEEP = 8            // 最多记最近这么多个选词
+    private const val PER_PAUSE = 4       // 每次停顿最多查这么多个（从最近的起）
+    private const val READ_MAX = 200      // 光标换词：光标前后各读这么多字来核对位置
+    private const val LOOKUP_SPAN = 6     // 词库查询：光标前后各交给 Lua 这么多字
+    private const val LOOKUP_WAIT_MS = 300
+    private const val SINGLE_MARK = '\u0001' // Lua 写回的词表里，带这个前缀的是光标处单字的同音字
+    private const val OPTIONS_MAX = 8     // 候选栏最多列这么多个
+    private const val SINGLES_MIN = 3     // 词和单字混排时给单字留的位置
+
+    class Pick(var start: Int, var word: String, var cands: List<String>, val aiChanged: Boolean) {
+        val threshold get() = if (aiChanged) THRESHOLD_AI else THRESHOLD
+        var scoredRight: String? = null   // 上次打分时的右文：没变就不再打分
+        var dismissed = false             // 提示过而没采纳、或已换过词：不再自动提示
+        val end get() = start + word.length
+
+        // 停顿时打过的整句分（键为左文与右文）：光标点回这个词时直接用，不用等打分
+        @Volatile var cache: Pair<String, Map<String, Double>>? = null
+    }
+
+    class Suggestion(val pick: Pick, val best: String, val right: String, val cursor: Int, val margin: Double)
+
+    /**
+     * 光标换词：options 已按整句分从高到低排好；margins 为各候选比原词高多少（打不了分时为 null）。
+     * 词和单字混排时 optPicks 给出每个候选替换的范围，为空表示都替换 pick。
+     */
+    class Choices(
+        val pick: Pick,
+        val options: List<String>,
+        val margins: List<Double>?,
+        val rightLen: Int,
+        val cursor: Int,
+        val optPicks: List<Pick> = emptyList(),
+    )
+
+    private val loaded =
+        runCatching { System.loadLibrary("rime_llm") }
+            .onFailure { Timber.w("SuzuFix: librime_llm.so not loaded") }
+            .isSuccess
+
+    @JvmStatic
+    private external fun nativeTake(word: ByteArray): Array<ByteArray>?
+
+    @JvmStatic
+    private external fun nativeLookupPut(text: ByteArray, cursor: Int): Long
+
+    @JvmStatic
+    private external fun nativeLookupWait(id: Long, timeoutMs: Int): Array<ByteArray>?
+
+    @JvmStatic
+    private external fun nativeScore(ctx: ByteArray, cands: Array<ByteArray>, budgetMs: Int): DoubleArray?
+
+    private val main = Handler(Looper.getMainLooper())
+    private val worker = Executors.newSingleThreadExecutor()
+    private val picks = ArrayDeque<Pick>()
+    private var pendingCommit: Pair<String, List<String>>? = null   // 第一项为类别 "1"/"0"，其后为候选
+    private var blocked = false
+    private var cursor = -1
+    private var gen = 0                   // 任何变化（光标、打字、换输入框）都加一，打分结果回来时不一致就丢弃
+
+    /** 当前的提示；变化时在主线程回调（null 表示收起） */
+    var current: Suggestion? = null
+        private set
+    var listener: ((Suggestion?) -> Unit)? = null
+
+    /** 当前列出的光标换词候选；变化时在主线程回调（null 表示收起） */
+    var choices: Choices? = null
+        private set
+    var choicesListener: ((Choices?) -> Unit)? = null
+    private var viewShown = false         // 候选栏正显示换词候选（光标跳动后可能已作废，等新结果替换）
+
+    var inputConnection: () -> InputConnection? = { null }
+
+    /** 通知 Lua 处理词库查询（由输入法服务设为在 Rime 线程上设运行时开关 suzu_fix_lookup） */
+    var requestLookup: () -> Unit = {}
+
+    private val check = Runnable { runCheck() }
+
+    // Suzu 词表里的字符。词表外的字符（句号、问号、数字、英文等）会让守护进程把整段记成无效分（-1e12），
+    // 所以右文截到第一个词表外的字符为止，原词与候选含词表外字符的不比较。读不到词表时不截，靠分数检查兜底。
+    private val vocab: Set<String>? by lazy {
+        runCatching {
+            File(DataManager.userDataDir, "suzu.vocab.txt").readLines().map { it.substringBefore('\t') }.toHashSet()
+        }.getOrNull()
+    }
+    private const val INVALID = -1e11
+
+    private fun inVocab(t: String): Boolean {
+        val v = vocab ?: return true
+        var i = 0
+        while (i < t.length) {
+            val n = Character.charCount(t.codePointAt(i))
+            if (t.substring(i, i + n) !in v) return false
+            i += n
+        }
+        return true
+    }
+
+    private fun vocabPrefix(t: String): String {
+        val v = vocab ?: return t
+        var i = 0
+        while (i < t.length) {
+            val n = Character.charCount(t.codePointAt(i))
+            if (t.substring(i, i + n) !in v) break
+            i += n
+        }
+        return t.substring(0, i)
+    }
+
+    // 进入一个输入框（密码框、无痕模式等不查）或离开
+    fun reset(block: Boolean) {
+        blocked = block
+        picks.clear()
+        pendingCommit = null
+        cursor = -1
+        cancel()
+    }
+
+    // 上屏（主线程）：Lua 登记过的词与上屏文字相同才领取，等光标更新后定位
+    fun onCommit(text: String) {
+        pendingCommit = null
+        if (!loaded || blocked || text.isEmpty()) return
+        val cs = runCatching { nativeTake(text.toByteArray()) }.getOrNull() ?: return
+        if (cs.size < 2) return
+        pendingCommit = text to cs.map { String(it) }
+        diag("take", 0.0, text.length, 0, cs[0].contentEquals("1".toByteArray()))
+    }
+
+    // 开始打字（出现候选）：收起提示、取消计时
+    fun onTyping() = cancel()
+
+    // 光标更新（主线程）。jumped：用户点击或拖动了光标（不是输入法自己的编辑）
+    fun onSelection(selStart: Int, selEnd: Int, composing: Boolean, jumped: Boolean) {
+        // 有的应用会重复报告同一个光标位置：什么都没变，就别收起刚列出的候选
+        if (!jumped && !composing && selStart == selEnd && selStart == cursor && pendingCommit == null) return
+        // 光标跳动时先不收起候选栏：等新的候选出来直接替换，没有可列的再收起（先收起会露出一帧工具栏，看着像闪）
+        cancel(keepView = jumped)
+        cursor = if (selStart == selEnd && !composing) selStart else -1
+        if (cursor < 0 || !loaded || blocked) {
+            hideStale()
+            return
+        }
+        pendingCommit?.let { (w, cs) ->
+            pendingCommit = null
+            val start = cursor - w.length
+            val ic = inputConnection()
+            val before = runCatching { ic?.getTextBeforeCursor(w.length, 0)?.toString() }.getOrNull()
+            if (start >= 0 && before == w) {
+                // 在中间补字时，同一位置可能还留着旧记录
+                picks.removeAll { it.start < cursor && it.end > start }
+                val p = Pick(start, w, cs.drop(1), cs[0] == "1")
+                picks.addLast(p)
+                diag("pick", 0.0, w.length, 0, p.aiChanged)
+                while (picks.size > KEEP) picks.removeFirst()
+            }
+        }
+        if (jumped) {
+            if (offerChoices()) return
+            hideStale()
+        }
+        // 位置可能已经不对（之前的文字改过），打分前按文字核对；这里只决定要不要等停顿
+        if (picks.any { !it.dismissed && it.end <= cursor && cursor - it.start <= SPAN_MAX }) {
+            main.postDelayed(check, PAUSE_MS)
+        }
+    }
+
+    private fun cancel(keepView: Boolean = false) {
+        gen++
+        main.removeCallbacks(check)
+        if (current != null) {
+            current?.let { it.pick.dismissed = true; stat("ignored", it) }
+            current = null
+            listener?.invoke(null)
+        }
+        if (choices != null) {
+            choices?.let { diag("unchosen", 0.0, it.pick.word.length, it.rightLen, it.pick.aiChanged) }
+            choices = null
+        }
+        if (!keepView) hideStale()
+    }
+
+    // 候选栏还显示着已经作废的换词候选：收起
+    private fun hideStale() {
+        if (choices == null && viewShown) {
+            viewShown = false
+            choicesListener?.invoke(null)
+        }
+    }
+
+    // 异步打分或查词库的结果回到主线程：还是同一次光标位置才显示，没有可列的就收起旧的
+    private fun finish(g: Int, cur: Int, result: Choices?, t0: Long) {
+        main.post {
+            if (gen != g || cursor != cur) return@post
+            if (result != null) showChoices(result, System.currentTimeMillis() - t0) else hideStale()
+        }
+    }
+
+    // 读光标前后的文字，返回 (文字, 文字起点在输入框里的位置)
+    private fun around(ic: InputConnection, cur: Int, before: Int, after: Int): Pair<String, Int>? {
+        val b = runCatching { ic.getTextBeforeCursor(before, 0)?.toString() }.getOrNull() ?: return null
+        val a = if (after > 0) runCatching { ic.getTextAfterCursor(after, 0)?.toString() }.getOrNull() ?: "" else ""
+        return (b + a) to (cur - b.length)
+    }
+
+    private fun matches(p: Pick, text: String, base: Int): Boolean {
+        val off = p.start - base
+        return off >= 0 && off + p.word.length <= text.length && text.regionMatches(off, p.word, 0, p.word.length)
+    }
+
+    // 光标点到最近选过的词上：词首正好在光标处（光标后的词）优先，其次光标在词中；光标前的词不算，
+    // 免得在句末接着打字时被打扰
+    // 没有选词记录（以前打的、粘贴的文字）时改查词库，见 lookupChoices
+    private fun offerChoices(): Boolean {
+        val cur = cursor
+        val ic = inputConnection() ?: return false
+        val (text, base) = around(ic, cur, READ_MAX, READ_MAX) ?: return false
+        val near = picks.filter { it.start <= cur && cur < it.end }
+        val valid = near.filter { matches(it, text, base) }
+        picks.removeAll { it in near && it !in valid }
+        val p = valid.lastOrNull { it.start == cur } ?: valid.lastOrNull() ?: return lookupChoices(text, base, cur)
+        val off = p.start - base
+        val left = text.substring(maxOf(0, off - LEFT_MAX), off)
+        val right = vocabPrefix(text.substring(off + p.word.length).take(RIGHT_MAX))
+        val others = p.cands.filter { it != p.word }
+        val splittable = p.word.length > 1   // 词里的一个字也能单独换，要多查一次词库
+        if (others.isEmpty() && !splittable) return false
+        val all = listOf(p.word) + others
+        val key = cacheKey(left, right)
+        val hit = p.cache?.takeIf { it.first == key }?.second?.takeIf { m -> all.all { it in m } }
+        if (hit != null && !splittable) {
+            showChoices(rank(p, others, DoubleArray(all.size) { hit.getValue(all[it]) }, right.length, cur), 0)
+            return true
+        }
+        val g = gen
+        val t0 = System.currentTimeMillis()
+        worker.execute {
+            val tot = hit?.let { m -> DoubleArray(all.size) { m.getValue(all[it]) } }
+                ?: if (inVocab(p.word)) scoreAll(left, right, all) { gen == g } else null
+            if (tot != null) p.cache = key to all.indices.associate { all[it] to tot[it] }
+            var c = rank(p, others, tot, right.length, cur)
+            if (splittable) {
+                val w = lookupWindow(text, base, cur)
+                c = withSingles(c, singlesOf(w?.let { lookup(it.first, it.second) }), text, base, cur, g)
+            }
+            finish(g, cur, c.takeIf { it.options.isNotEmpty() }, t0)
+        }
+        return true
+    }
+
+    // 词库查询：把光标前后各几个字交给 Lua（客户端库转交，运行时开关通知），由它找出光标处的词和同音词，
+    // 再与选词记录一样打整句分、排序。Lua 还返回光标处单字的同音字，两者混排。这样的词不记进 picks，也不自动提示。
+    private fun lookupChoices(text: String, base: Int, cur: Int): Boolean {
+        val w = lookupWindow(text, base, cur) ?: return false
+        val g = gen
+        val t0 = System.currentTimeMillis()
+        worker.execute { finish(g, cur, lookupWork(w.first, w.second, text, base, w.third, cur, g, t0), t0) }
+        return true
+    }
+
+    // 光标前后各 LOOKUP_SPAN 个字：(文字, 光标在其中的字数位置, 文字在 text 里的起点)；没有汉字时返回 null
+    private fun lookupWindow(text: String, base: Int, cur: Int): Triple<String, Int, Int>? {
+        val k = cur - base
+        if (k < 0 || k > text.length) return null
+        var ws = maxOf(0, k - LOOKUP_SPAN)
+        var we = minOf(text.length, k + LOOKUP_SPAN)
+        if (ws > 0 && Character.isLowSurrogate(text[ws])) ws++   // 别切开代理对
+        if (we < text.length && Character.isLowSurrogate(text[we])) we--
+        val win = text.substring(ws, we)
+        if (win.none { it in '\u4e00'..'\u9fff' }) return null
+        return Triple(win, win.codePointCount(0, k - ws), ws)
+    }
+
+    // 后台线程：交给 Lua 查，返回 [起点, 终点, 原词, 同音词…]；没找到时为空，超时返回 null
+    private fun lookup(win: String, kc: Int): List<String>? {
+        val id = runCatching { nativeLookupPut(win.toByteArray(), kc) }.getOrNull() ?: return null
+        requestLookup()
+        return runCatching { nativeLookupWait(id, LOOKUP_WAIT_MS) }.getOrNull()?.map { String(it) }
+    }
+
+    // 查询结果里光标处单字的同音字：单字自成一段时就是同音词本身，否则是带前缀的那些
+    private fun singlesOf(r: List<String>?): List<String> {
+        if (r == null || r.size < 4) return emptyList()
+        val marked = r.drop(3).filter { it.startsWith(SINGLE_MARK) }.map { it.substring(1) }
+        if (marked.isNotEmpty()) return marked
+        return if (r[2].length == 1) r.drop(3) else emptyList()
+    }
+
+    // 后台线程：查词库、打分；查不到或作废时返回 null
+    private fun lookupWork(win: String, kc: Int, text: String, base: Int, ws: Int, cur: Int, g: Int, t0: Long): Choices? {
+        run {
+            if (gen != g) return null
+            val r = lookup(win, kc)
+            if (r == null || r.size < 4) {
+                diag(if (r == null) "lookup_timeout" else "lookup_none", 0.0, 0, 0, false, ms = System.currentTimeMillis() - t0)
+                return null
+            }
+            val s = runCatching { win.offsetByCodePoints(0, r[0].toInt()) }.getOrNull() ?: return null
+            val e = runCatching { win.offsetByCodePoints(0, r[1].toInt()) }.getOrNull() ?: return null
+            val word = r[2]
+            if (win.substring(s, e) != word) return null
+            val others = r.drop(3).filter { it != word && !it.startsWith(SINGLE_MARK) }
+            val singles = if (word.length > 1) singlesOf(r) else emptyList()
+            if (others.isEmpty() && singles.isEmpty()) return null
+            diag("lookup", 0.0, word.length, 0, false, ms = System.currentTimeMillis() - t0)
+            val p = Pick(base + ws + s, word, others, false).apply { dismissed = true }
+            val off = ws + s
+            val left = text.substring(maxOf(0, off - LEFT_MAX), off)
+            val right = vocabPrefix(text.substring(ws + e).take(RIGHT_MAX))
+            val tot = if (inVocab(word)) scoreAll(left, right, listOf(word) + others) { gen == g } else null
+            return withSingles(rank(p, others, tot, right.length, cur), singles, text, base, cur, g)
+                .takeIf { it.options.isNotEmpty() }
+        }
+    }
+
+    // 把光标处单字的同音字并进候选：各自打整句分，按比原文高多少统一排序，单字至少留 SINGLES_MIN 个位置
+    private fun withSingles(c: Choices, singles: List<String>, text: String, base: Int, cur: Int, g: Int): Choices {
+        val off = cur - base
+        if (singles.isEmpty() || off >= text.length) return c
+        val ch = text.substring(off, off + 1)
+        val sp = Pick(cur, ch, singles, false).apply { dismissed = true }
+        val left = text.substring(maxOf(0, off - LEFT_MAX), off)
+        val right = vocabPrefix(text.substring(off + 1).take(RIGHT_MAX))
+        val tot = if (inVocab(ch)) scoreAll(left, right, listOf(ch) + singles) { gen == g } else null
+        val sc = rank(sp, singles, tot, right.length, cur)
+        val nS = minOf(sc.options.size, maxOf(SINGLES_MIN, OPTIONS_MAX - c.options.size))
+        val nW = minOf(c.options.size, OPTIONS_MAX - nS)
+        class Opt(val word: String, val pick: Pick, val margin: Double?)
+        val opts = c.options.take(nW).mapIndexed { i, w -> Opt(w, c.pick, c.margins?.get(i)) } +
+            sc.options.take(nS).mapIndexed { i, w -> Opt(w, sp, sc.margins?.get(i)) }
+        // 有一边打不了分时不比较分数：词在前，单字在后
+        val scored = opts.all { it.margin != null }
+        val sorted = if (scored) opts.sortedByDescending { it.margin!! } else opts
+        return Choices(
+            c.pick,
+            sorted.map { it.word },
+            if (scored) sorted.map { it.margin!! } else null,
+            c.rightLen,
+            cur,
+            sorted.map { it.pick },
+        )
+    }
+
+    private fun cacheKey(left: String, right: String) = left + "\u0001" + right
+
+    // tot 的第 0 项是原词，其后与 others 同序
+    private fun rank(p: Pick, others: List<String>, tot: DoubleArray?, rightLen: Int, cur: Int): Choices =
+        if (tot == null || tot[0] == Double.NEGATIVE_INFINITY) {
+            Choices(p, others, null, rightLen, cur)   // 打不了分：按原来的页内顺序
+        } else {
+            val order = others.indices.sortedByDescending { tot[it + 1] }
+            Choices(p, order.map { others[it] }, order.map { tot[it + 1] - tot[0] }, rightLen, cur)
+        }
+
+    private fun showChoices(c: Choices, waitMs: Long) {
+        choices = c
+        viewShown = true
+        diag("offer", c.margins?.firstOrNull() ?: 0.0, c.pick.word.length, c.rightLen, c.pick.aiChanged, ms = waitMs)
+        choicesListener?.invoke(c)
+    }
+
+    /** 点了光标换词的第 i 个候选：核对原词还在原处，再整段替换（replace(起点, 终点, 新词)）。返回是否替换了 */
+    fun choose(i: Int, replace: (Int, Int, String) -> Boolean): Boolean {
+        val c = choices ?: return false
+        choices = null
+        hideStale()
+        val p = c.optPicks.getOrNull(i) ?: c.pick
+        val word = c.options.getOrNull(i) ?: return false
+        val ic = inputConnection() ?: return false
+        val (text, base) = around(ic, cursor, READ_MAX, READ_MAX) ?: return false
+        val margin = c.margins?.getOrNull(i) ?: 0.0
+        if (cursor != c.cursor || !matches(p, text, base)) {
+            picks.remove(p)
+            diag("stale", margin, p.word.length, c.rightLen, p.aiChanged, i)
+            return false
+        }
+        val old = p.word
+        val oldEnd = p.end
+        if (!replace(p.start, oldEnd, word)) {
+            diag("stale", margin, p.word.length, c.rightLen, p.aiChanged, i)
+            return false
+        }
+        // 换过的词仍然可以再换（原词放回候选里），后面记录的位置跟着移动
+        val delta = word.length - old.length
+        for (q in picks) if (q !== p && q.start >= oldEnd) q.start += delta
+        p.word = word
+        p.cands = p.cands.map { if (it == word) old else it }
+        p.dismissed = true
+        p.scoredRight = null
+        diag("chose", margin, old.length, c.rightLen, p.aiChanged, i)
+        return true
+    }
+
+    private class Job(val pick: Pick, val left: String, val right: String)
+
+    private fun runCheck() {
+        val g = gen
+        val cur = cursor
+        if (cur < 0) return
+        val ic = inputConnection() ?: return
+        val before = runCatching { ic.getTextBeforeCursor(SPAN_MAX + LEFT_MAX, 0)?.toString() }.getOrNull() ?: return
+        val base = cur - before.length
+        val jobs = mutableListOf<Job>()
+        for (p in picks.toList().asReversed()) {
+            if (p.dismissed || p.end > cur || p.start < base) continue   // 光标后面的、太远的不查（也不删，光标换词还要用）
+            val off = p.start - base
+            if (!matches(p, before, base)) {
+                picks.remove(p)   // 前面的文字改过了，位置对不上
+                continue
+            }
+            val right = vocabPrefix(before.substring(off + p.word.length).take(RIGHT_MAX))
+            if (right.isEmpty() || right == p.scoredRight || !inVocab(p.word)) continue
+            p.scoredRight = right
+            jobs += Job(p, before.substring(maxOf(0, off - LEFT_MAX), off), right)
+            if (jobs.size >= PER_PAUSE) break
+        }
+        if (jobs.isEmpty()) return
+        worker.execute {
+            var best: Suggestion? = null
+            for (j in jobs) {
+                if (gen != g) return@execute
+                val s = score(j, cur) { gen == g }
+                if (s == null) {
+                    if (gen == g) diag("fail", 0.0, j.pick.word.length, j.right.length, j.pick.aiChanged)
+                    continue
+                }
+                diag("check", s.margin, j.pick.word.length, j.right.length, j.pick.aiChanged)
+                // 多个都过门槛时取超出门槛最多的
+                if (s.margin > j.pick.threshold &&
+                    (best == null || s.margin - j.pick.threshold > best.margin - best.pick.threshold)
+                ) {
+                    best = s
+                }
+            }
+            val found = best ?: return@execute
+            main.post {
+                if (gen != g || cursor != cur) return@post
+                current = found
+                stat("shown", found)
+                listener?.invoke(found)
+            }
+        }
+    }
+
+    // 后台线程：各词的整句分（右文为空时只有左文这一段）。词表外或无效的记为负无穷；整体失败返回 null
+    private fun scoreAll(left: String, right: String, all: List<String>, alive: () -> Boolean): DoubleArray? {
+        val ok = all.map { inVocab(it) }
+        val idx = all.indices.filter { ok[it] }
+        if (idx.size < 2) return null
+        val s0 = nativeScore(left.toByteArray(), idx.map { all[it].toByteArray() }.toTypedArray(), BUDGET_MS) ?: return null
+        val tot = DoubleArray(all.size) { Double.NEGATIVE_INFINITY }
+        val pad = if (right == "的") "了" else "的"
+        for ((k, i) in idx.withIndex()) {
+            if (!alive()) return null
+            if (s0[k] <= INVALID) continue
+            var r = 0.0
+            if (right.isNotEmpty()) {
+                val rs = nativeScore((left + all[i]).toByteArray(), arrayOf(right.toByteArray(), pad.toByteArray()), BUDGET_MS)
+                    ?: return null
+                if (rs[0] <= INVALID) return null
+                r = rs[0]
+            }
+            tot[i] = s0[k] + r
+        }
+        return tot
+    }
+
+    // 后台线程：原词与候选的整句分，返回最高的候选（分差可能为负）
+    private fun score(j: Job, cur: Int, alive: () -> Boolean): Suggestion? {
+        val all = listOf(j.pick.word) + j.pick.cands.filter { it != j.pick.word && inVocab(it) }
+        val tot = scoreAll(j.left, j.right, all, alive) ?: return null
+        j.pick.cache = cacheKey(j.left, j.right) to all.indices.associate { all[it] to tot[it] }
+        if (tot[0] == Double.NEGATIVE_INFINITY) return null
+        // 自动提示只比前 4 个候选（离线评估就是这么定的门槛），8 个全打分是为了光标换词的缓存
+        var bi = 1
+        for (i in 2 until minOf(all.size, 5)) if (tot[i] > tot[bi]) bi = i
+        if (tot[bi] == Double.NEGATIVE_INFINITY) return null
+        return Suggestion(j.pick, all[bi], j.right, cur, tot[bi] - tot[0])
+    }
+
+    /** 点了提示：核对光标前的文字仍是“原词 + 右文”，再整段替换。返回是否替换了 */
+    fun accept(replace: (Int, String) -> Boolean): Boolean {
+        val s = current ?: return false
+        current = null
+        listener?.invoke(null)
+        val ic = inputConnection()
+        val want = s.pick.word + s.right
+        val now = runCatching { ic?.getTextBeforeCursor(want.length, 0)?.toString() }.getOrNull()
+        if (cursor != s.cursor || now != want) {
+            stat("stale", s)
+            return false
+        }
+        picks.remove(s.pick)
+        val ok = replace(want.length, s.best + s.right)
+        stat(if (ok) "accepted" else "stale", s)
+        return ok
+    }
+
+    /** 点了关闭 */
+    fun dismiss() = cancel()
+
+    private fun stat(event: String, s: Suggestion) = diag(event, s.margin, s.pick.word.length, s.right.length, s.pick.aiChanged)
+
+    private fun diag(event: String, margin: Double, wordLen: Int, rightLen: Int, aiChanged: Boolean, rank: Int = -1, ms: Long = -1) {
+        val cls = if (aiChanged) 1 else 0
+        val m = if (margin.isFinite()) Math.round(margin * 10) else -9999
+        val line = "${System.currentTimeMillis() / 1000}\t$event\t$m\t$wordLen\t$rightLen\t$cls\t$rank\t$ms\n"
+        worker.execute {
+            runCatching { File(DataManager.userDataDir, "fix_stats.tsv").appendText(line) }
+        }
+    }
+}
