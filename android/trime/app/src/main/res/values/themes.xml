<resources>
    <style name="Theme.TrimeAppTheme" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/m3_primary</item>
        <item name="colorOnPrimary">@color/m3_onPrimary</item>
        <item name="colorPrimaryContainer">@color/m3_primaryContainer</item>
        <item name="colorOnPrimaryContainer">@color/m3_onPrimaryContainer</item>
        <item name="colorSecondary">@color/m3_secondary</item>
        <item name="colorOnSecondary">@color/m3_onSecondary</item>
        <item name="colorSecondaryContainer">@color/m3_secondaryContainer</item>
        <item name="colorOnSecondaryContainer">@color/m3_onSecondaryContainer</item>
        <item name="colorTertiary">@color/m3_tertiary</item>
        <item name="colorOnTertiary">@color/m3_onTertiary</item>
        <item name="colorTertiaryContainer">@color/m3_tertiaryContainer</item>
        <item name="colorOnTertiaryContainer">@color/m3_onTertiaryContainer</item>
        <item name="colorError">@color/m3_error</item>
        <item name="colorOnError">@color/m3_onError</item>
        <item name="colorErrorContainer">@color/m3_errorContainer</item>
        <item name="colorOnErrorContainer">@color/m3_onErrorContainer</item>
        <item name="colorSurface">@color/m3_surface</item>
        <item name="colorOnSurface">@color/m3_onSurface</item>
        <item name="colorSurfaceVariant">@color/m3_surfaceVariant</item>
        <item name="colorOnSurfaceVariant">@color/m3_onSurfaceVariant</item>
        <item name="colorOutline">@color/m3_outline</item>
        <item name="colorOutlineVariant">@color/m3_outlineVariant</item>
        <item name="colorSurfaceContainerLowest">@color/m3_surfaceContainerLowest</item>
        <item name="colorSurfaceContainerLow">@color/m3_surfaceContainerLow</item>
        <item name="colorSurfaceContainer">@color/m3_surfaceContainer</item>
        <item name="colorSurfaceContainerHigh">@color/m3_surfaceContainerHigh</item>
        <item name="colorSurfaceContainerHighest">@color/m3_surfaceContainerHighest</item>
        <item name="colorSurfaceDim">@color/m3_surfaceDim</item>
        <item name="colorSurfaceBright">@color/m3_surfaceBright</item>
        <item name="colorSurfaceInverse">@color/m3_inverseSurface</item>
        <item name="colorOnSurfaceInverse">@color/m3_inverseOnSurface</item>
        <item name="colorPrimaryInverse">@color/m3_inversePrimary</item>
        <item name="android:colorBackground">@color/m3_page</item>
        <item name="android:windowBackground">@color/m3_page</item>
        <item name="colorOnBackground">@color/m3_onSurface</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="preferenceTheme">@style/PreferenceThemeOverlay.Trime</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.Trime.MaterialAlertDialog</item>
        <item name="bottomSheetDialogTheme">@style/ThemeOverlay.Trime.BottomSheetDialog</item>
    </style>

    <!-- 对话框：确认按钮用实心按钮 -->
    <style name="ThemeOverlay.Trime.MaterialAlertDialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="buttonBarPositiveButtonStyle">@style/Widget.Trime.DialogButton.Filled</item>
        <item name="materialAlertDialogTitleTextStyle">@style/MaterialAlertDialog.Trime.Title.Text</item>
        <item name="shapeAppearanceCornerExtraLarge">@style/ShapeAppearance.Trime.Dialog</item>
    </style>

    <!-- 中心对话框：圆角矩形，圆角比 Material 3 默认的 28dp 小 -->
    <style name="ShapeAppearance.Trime.Dialog" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">16dp</item>
    </style>

    <style name="MaterialAlertDialog.Trime.Title.Text" parent="MaterialAlertDialog.Material3.Title.Text">
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Widget.Trime.DialogButton.Filled" parent="Widget.Material3.Button">
        <item name="android:layout_marginStart">8dp</item>
    </style>

    <style name="ThemeOverlay.Trime.BottomSheetDialog" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/Widget.Trime.BottomSheet</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="Widget.Trime.BottomSheet" parent="Widget.Material3.BottomSheet.Modal">
        <item name="backgroundTint">?attr/colorSurfaceContainerHigh</item>
    </style>

    <!-- 页面大标题 -->
    <style name="TextAppearance.Trime.PageTitle" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.Trime.AppTitle" parent="TextAppearance.Material3.DisplaySmall">
        <item name="android:textStyle">bold</item>
    </style>

    <!-- 设置页的开关换成 Material 3 的 MaterialSwitch -->
    <style name="PreferenceThemeOverlay.Trime" parent="@style/PreferenceThemeOverlay">
        <item name="switchPreferenceCompatStyle">@style/Preference.SwitchPreferenceCompat.Trime</item>
        <item name="preferenceCategoryStyle">@style/Preference.Category.Trime</item>
    </style>

    <style name="Preference.SwitchPreferenceCompat.Trime" parent="@style/Preference.SwitchPreferenceCompat.Material">
        <item name="widgetLayout">@layout/preference_material_switch</item>
    </style>

    <style name="Preference.Category.Trime" parent="@style/Preference.Category.Material">
        <item name="android:layout">@layout/preference_category_card</item>
    </style>

    <style name="Theme.DialogTheme" parent="@android:style/Theme.DeviceDefault.Light.Dialog" />
</resources>
