<!-- 选错修正提示：上面是普通的开关项，下面是停顿时间的折叠入口和滑块，同在一项里（之间没有分隔线） -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- 与其他开关项相同的 Material 布局（字号、间距一致） -->
    <include layout="@layout/preference_material" />

    <LinearLayout
        android:id="@+id/fix_pause_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="-8dp"
        android:background="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:minHeight="40dp"
        android:orientation="horizontal"
        android:paddingStart="?android:attr/listPreferredItemPaddingStart"
        android:paddingEnd="?android:attr/listPreferredItemPaddingEnd">

        <TextView
            android:id="@+id/fix_pause_label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?android:attr/textColorSecondary" />

        <ImageView
            android:id="@+id/fix_pause_arrow"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:importantForAccessibility="no" />
    </LinearLayout>

    <com.google.android.material.slider.Slider
        android:id="@+id/fix_pause_slider"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="4dp"
        android:layout_marginBottom="8dp"
        android:stepSize="0.5"
        app:thumbHeight="16dp"
        app:thumbTrackGapSize="0dp"
        app:thumbWidth="16dp"
        app:tickVisible="false"
        app:trackHeight="4dp"
        app:trackStopIndicatorSize="0dp"
        android:valueFrom="0.5"
        android:valueTo="5.0"
        android:visibility="gone" />
</LinearLayout>
